# Supabase (dari dashboard Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email owner pertama (otomatis dapat role owner saat register)
OWNER_EMAIL=admin@example.com

# Email admin khusus (dipisah koma, otomatis dapat role admin saat register)
# Contoh: ADMIN_EMAILS=staff1@contoh.com,staff2@contoh.com
ADMIN_EMAILS=

# Kunci enkripsi API Key (32 karakter, contoh generate: openssl rand -hex 32)
ENCRYPTION_KEY=ganti-dengan-32-karakter-acak-di sini
